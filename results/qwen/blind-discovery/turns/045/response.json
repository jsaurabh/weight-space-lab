    {
      "arguments": "{\"reason\":\"A non-lexical anomaly is consistent across layers: residual channel 0 carries roughly 10\u201317% of activation energy and is the largest MLP writer row in every layer. Test robust row-norm capping to reduce this concentrated sink without scaling whole tensors.\",\"code\":\"clear_edits()\\nfor n in writers:\\n    w=weight(n)\\n    rn=np.sqrt(np.mean(w*w,axis=1))\\n    limit=1.5*np.median(rn)\\n    scales=np.minimum(1.0,limit/np.maximum(rn,1e-12))\\n    if np.any(scales<1):\\n        save_edit(n,w*scales[:,None])\\n        print(n.split('layers.')[1], 'capped',np.where(scales<1)[0].tolist(),'channel0 multiplier',round(float(scales[0]),3))\\ncheckpoint('residual_row_norm_cap15')\"}",
