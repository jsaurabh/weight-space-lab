      "arguments": "{\"reason\":\"Compare residual directions that suppress both Wait tokenizations and/or boost stop/final, estimating logit shifts.\",\"code\":\"E=weight('model.language_model.embed_tokens.weight'); fn=weight('model.language_model.norm.weight')\\nids={s:tokenize(s)[-1] for s in ['Wait',' Wait','</think>','Final','But','Let',' Yes',' So',' $','0','1','2']}\\ndef direction(formula):\\n    d=np.zeros(1024,dtype=np.float32)\\n    for s,coef in formula.items(): d += coef*E[ids[s]]\\n    return fn*d\\nforms={\\n    'stop_minus_avgwait': {'</think>':1,'Wait':-0.5,' Wait':-0.5},\\n    'stop_final_minus_waits': {'</think>':0.7,'Final':0.7,'Wait':-0.7,' Wait':-0.7},\\n    'final_minus_avgwait': {'Final':1,'Wait':-0.5,' Wait':-0.5},\\n    'anti_waits': {'Wait':-0.5,' Wait':-0.5},\\n    'stop_answer_final_minus_waits': {'</think>':0.5,'Final':0.4,' answer':0.3,'Wait':-0.6,' Wait':-0.6},\\n}\\np=artifact('probe-002')\\nsel=['Wait',' Wait','</think>','Final','But','Let',' Yes',' So',' $','0','1','2']\\nfor name,form in forms.items():\\n    d=direction(form); print('\\\\n',name,'norm',np.linalg.norm(d))\\n    for c in [2,4,6,8]:\\n        changes=[]\\n        for t in p['texts']:\\n            h=np.array(t['hidden'])[-1,0,:].astype(np.float32)\\n            def normed(hh): return hh/np.sqrt(np.mean(hh*hh)+1e-6)*fn\\n            dl=E[[ids[s] for s in sel]]@(normed(h+c*d)-normed(h))\\n            changes.append(dl)\\n        avg=np.mean(changes,axis=0)\\n        print('c',c,'avg', {sel[i]:round(float(avg[i]),2) for i in range(4)}, 'normadd',round(float(np.linalg.norm(c*d)),2))\\n    # text7 top approximate changes at c=6\\n    t=p['texts'][7]; h=np.array(t['hidden'])[-1,0,:].astype(np.float32)\\n    def normed(hh): return hh/np.sqrt(np.mean(hh*hh)+1e-6)*fn\\n    dl=E[[ids[s] for s in sel]]@(normed(h+6*d)-normed(h))\\n    print('text7 c6', {sel[i]:round(float(dl[i]),2) for i in range(len(sel))})\\n\"}",
