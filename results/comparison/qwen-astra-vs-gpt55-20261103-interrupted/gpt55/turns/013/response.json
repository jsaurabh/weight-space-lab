      "arguments": "{\"reason\":\"Estimate embedding norms and logit-effect scales for candidate residual directions (stop-vs-wait).\",\"code\":\"E=weight('model.language_model.embed_tokens.weight')\\nfn=weight('model.language_model.norm.weight')\\nids={s:tokenize(s)[-1] for s in ['Wait',' Wait','</think>','Final',' answer','boxed','\\\\n']}\\nfor s,id in ids.items(): print(s,id,'embnorm',np.linalg.norm(E[id]), 'emb first', E[id,:3])\\nvecs={}\\nfor name,(good,bad) in {\\n    'stop- Wait':('</think>',' Wait'),\\n    'stop-Wait':('</think>','Wait'),\\n    'final-Wait':('Final','Wait'),\\n    'answer-Wait':(' answer','Wait'),\\n}.items():\\n    g=E[ids[good]]; b=E[ids[bad]]\\n    d=fn*(g-b)\\n    vecs[name]=d\\n    print(name,'norm',np.linalg.norm(d),'plainnorm',np.linalg.norm(g-b),'dot effects approx raw', {s: float(E[id]@(fn*d/np.sqrt(1024))) for s,id in ids.items()})\\n# compute for unit norm d effects at probed contexts via exact norm approx: logits before/after adding c*d\\np=artifact('probe-002')\\nfor name,d in vecs.items():\\n    d=d.astype(np.float32)\\n    print('\\\\n',name)\\n    for c in [0.5,1,2,4,8]:\\n        changes=[]\\n        for t in p['texts'][:8]:\\n            h=np.array(t['hidden'])[-1,0,:].astype(np.float32)\\n            def normed(hh): return (hh/np.sqrt(np.mean(hh*hh)+1e-6))*fn\\n            hn0=normed(h); hn1=normed(h+c*d)\\n            logit_change=(E[[ids['Wait'],ids[' Wait'],ids['</think>'],ids['Final']]]@(hn1-hn0))\\n            changes.append(logit_change)\\n        avg=np.mean(changes,axis=0)\\n        print('c',c,'avg dlogit Wait,spWait,stop,Final',avg,'norm added',np.linalg.norm(c*d))\\n\"}",
